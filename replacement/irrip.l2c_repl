#include "cache.h"
#include <cstdint>

#define maxRRPV 3

// Each RRPV is in the range [0, 3], so 8 bits are sufficient.
// Align the start of the array to a 64-byte cache-line boundary.
alignas(64) uint8_t l2_irrip_rrpv[L2C_SET][L2C_WAY];

void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize I-RRIP state for L2C" << endl;

    for (uint32_t set = 0; set < L2C_SET; set++) {
        for (uint32_t way = 0; way < L2C_WAY; way++) {
            l2_irrip_rrpv[set][way] = maxRRPV;
        }
    }
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // 1. Prefer invalid ways; no RRPV changes are required.
    for (uint32_t way = 0; way < L2C_WAY; way++) {
        if (!current_set[way].valid) {
            return way;
        }
    }

    // 2. Select a victim. Age the entries only when necessary.
    while (true) {

        // Prefer a non-instruction cache line with maxRRPV.
        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_irrip_rrpv[set][way] == maxRRPV &&
                !current_set[way].instruction) {
                return way;
            }
        }

        // Fall back to any cache line with maxRRPV.
        for (uint32_t way = 0; way < L2C_WAY; way++)
            if (l2_irrip_rrpv[set][way] == maxRRPV)
                return way;

        // No entry has maxRRPV: age all entries and search again.
        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_irrip_rrpv[set][way] < maxRRPV)
                l2_irrip_rrpv[set][way]++;
        }
    }
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    if (hit)
        l2_irrip_rrpv[set][way] = isInstruction ? 0 : maxRRPV - 2;
    else
        l2_irrip_rrpv[set][way] = isInstruction ? maxRRPV - 2 : maxRRPV - 1;
}

void CACHE::l2c_replacement_final_stats()
{
}
