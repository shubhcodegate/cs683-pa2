#include "cache.h"

#define maxRRPV 3
#define DYN_IRRIP_LEADER_SET_STRIDE 32
#define DYN_IRRIP_INSTRUCTION_THRESHOLD 0.25

uint8_t l2_dyn_irrip_rrpv[L2C_SET][L2C_WAY];
uint64_t l2_dyn_irrip_instruction_accesses;
uint64_t l2_dyn_irrip_instruction_misses;
uint64_t l2_dyn_irrip_data_accesses;
uint64_t l2_dyn_irrip_data_misses;

static bool l2_dyn_irrip_is_leader_set(uint32_t set)
{
    return set % DYN_IRRIP_LEADER_SET_STRIDE == 0;
}

static bool l2_dyn_irrip_prioritize_instructions()
{
    const uint64_t accesses = l2_dyn_irrip_instruction_accesses + l2_dyn_irrip_data_accesses;
    const uint64_t misses = l2_dyn_irrip_instruction_misses + l2_dyn_irrip_data_misses;
    const uint64_t total = accesses + misses;

    if (total == 0)
        return false;

    const double instruction_pressure =
        static_cast<double>(l2_dyn_irrip_instruction_accesses + l2_dyn_irrip_instruction_misses) /
        static_cast<double>(total);
    return instruction_pressure > DYN_IRRIP_INSTRUCTION_THRESHOLD;
}

static uint32_t l2_dyn_irrip_rrip_victim(uint32_t set, const BLOCK *current_set)
{
    for (uint32_t way = 0; way < L2C_WAY; way++) {
        if (!current_set[way].valid)
            return way;
    }

    while (true) {
        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_dyn_irrip_rrpv[set][way] == maxRRPV)
                return way;
        }

        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_dyn_irrip_rrpv[set][way] < maxRRPV)
                l2_dyn_irrip_rrpv[set][way]++;
        }
    }
}

static uint32_t l2_dyn_irrip_instruction_victim(uint32_t set, const BLOCK *current_set)
{
    for (uint32_t way = 0; way < L2C_WAY; way++) {
        if (!current_set[way].valid)
            return way;
    }

    while (true) {
        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_dyn_irrip_rrpv[set][way] == maxRRPV &&
                !current_set[way].instruction)
                return way;
        }

        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_dyn_irrip_rrpv[set][way] == maxRRPV)
                return way;
        }

        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_dyn_irrip_rrpv[set][way] < maxRRPV)
                l2_dyn_irrip_rrpv[set][way]++;
        }
    }
}

void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize dynamic I-RRIP state for L2C" << endl;

    for (uint32_t set = 0; set < L2C_SET; set++) {
        for (uint32_t way = 0; way < L2C_WAY; way++)
            l2_dyn_irrip_rrpv[set][way] = maxRRPV;
    }

    l2_dyn_irrip_instruction_accesses = 0;
    l2_dyn_irrip_instruction_misses = 0;
    l2_dyn_irrip_data_accesses = 0;
    l2_dyn_irrip_data_misses = 0;
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    if (l2_dyn_irrip_is_leader_set(set) || !l2_dyn_irrip_prioritize_instructions())
        return l2_dyn_irrip_rrip_victim(set, current_set);

    return l2_dyn_irrip_instruction_victim(set, current_set);
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    if (l2_dyn_irrip_is_leader_set(set)) {
        if (isInstruction) {
            l2_dyn_irrip_instruction_accesses++;
            if (!hit)
                l2_dyn_irrip_instruction_misses++;
        } else {
            l2_dyn_irrip_data_accesses++;
            if (!hit)
                l2_dyn_irrip_data_misses++;
        }
    }

    const bool prioritize_instructions =
        !l2_dyn_irrip_is_leader_set(set) && l2_dyn_irrip_prioritize_instructions();

    if (prioritize_instructions) {
        if (hit)
            l2_dyn_irrip_rrpv[set][way] = isInstruction ? 0 : maxRRPV - 2;
        else
            l2_dyn_irrip_rrpv[set][way] = isInstruction ? maxRRPV - 2 : maxRRPV - 1;
    } else if (hit) {
        l2_dyn_irrip_rrpv[set][way] = 0;
    } else {
        l2_dyn_irrip_rrpv[set][way] = maxRRPV - 1;
    }
}

void CACHE::l2c_replacement_final_stats()
{
    const uint64_t accesses = l2_dyn_irrip_instruction_accesses + l2_dyn_irrip_data_accesses;
    const uint64_t misses = l2_dyn_irrip_instruction_misses + l2_dyn_irrip_data_misses;
    const uint64_t total = accesses + misses;
    const double instruction_pressure = total == 0 ? 0.0 :
        static_cast<double>(l2_dyn_irrip_instruction_accesses + l2_dyn_irrip_instruction_misses) /
        static_cast<double>(total);

    cout << "Dynamic I-RRIP RRIP leader-set statistics:" << endl;
    cout << "  Instruction accesses: " << l2_dyn_irrip_instruction_accesses
         << ", misses: " << l2_dyn_irrip_instruction_misses << endl;
    cout << "  Non-instruction accesses: " << l2_dyn_irrip_data_accesses
         << ", misses: " << l2_dyn_irrip_data_misses << endl;
    cout << "  Instruction pressure: " << instruction_pressure
         << ", follower policy: "
         << (instruction_pressure > DYN_IRRIP_INSTRUCTION_THRESHOLD ? "I-RRIP" : "SRRIP")
         << endl;
}
